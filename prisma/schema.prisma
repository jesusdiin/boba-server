// Esquema del servidor de sync de Boba POS.
// Multi-tenant: organización → sucursales → dispositivos. Los eventos son el
// log de sync y, a la vez, el respaldo en la nube (ver boba_pos/docs/ARQUITECTURA.md).

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branches Branch[]
  devices  Device[]
  events   Event[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  timezoneId     String   @default("America/Mexico_City") @map("timezone_id")
  currencyCode   String   @default("MXN") @map("currency_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id])
  devices      Device[]
  pairingCodes DevicePairingCode[]
  events       Event[]
  states       AggregateState[]
  shiftAliases ShiftAlias[]
  conflicts    SyncConflict[]

  projectionCategories            BranchCategory[]
  projectionProducts              BranchProduct[]
  projectionModifierGroups        BranchModifierGroup[]
  projectionModifierOptions       BranchModifierOption[]
  projectionProductModifierGroups BranchProductModifierGroup[]
  projectionSupplies              BranchSupply[]
  projectionUsers                 BranchUser[]
  projectionShifts                BranchShift[]
  projectionSales                 BranchSale[]
  projectionSaleItems             BranchSaleItem[]
  projectionSaleItemModifiers     BranchSaleItemModifier[]
  projectionPayments              BranchPayment[]
  projectionCashMovements         BranchCashMovement[]
  projectionSupplyMovements       BranchSupplyMovement[]
  projectionIncomingOrders        BranchIncomingOrder[]

  @@index([organizationId])
  @@map("branches")
}

enum DeviceMode {
  staff
  kiosk

  @@map("device_mode")
}

model Device {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  branchId       String     @map("branch_id") @db.Uuid
  name           String
  mode           DeviceMode @default(staff)
  /// sha256 del token; el token en claro solo se entrega al emparejar.
  tokenHash      String     @unique @map("token_hash")
  lastSeenAt     DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  events       Event[]

  @@index([branchId])
  @@map("devices")
}

model DevicePairingCode {
  id             String    @id @default(uuid()) @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  /// sha256 del código (8 caracteres legibles).
  codeHash       String    @unique @map("code_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)
  usedByDeviceId String?   @map("used_by_device_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id])

  @@map("device_pairing_codes")
}

/// Log de eventos de sync. `serverSeq` es el cursor global del pull.
model Event {
  serverSeq       BigInt   @id @default(autoincrement()) @map("server_seq")
  /// Clave de idempotencia generada en el dispositivo (UUIDv7).
  eventId         String   @unique @map("event_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  deviceId        String   @map("device_id") @db.Uuid
  type            String
  aggregateType   String   @map("aggregate_type")
  aggregateId     String   @map("aggregate_id")
  v               Int
  payload         Json     @db.JsonB
  userId          String?  @map("user_id")
  deviceCreatedAt DateTime @map("device_created_at") @db.Timestamptz(3)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  device       Device       @relation(fields: [deviceId], references: [id])

  @@index([branchId, serverSeq])
  @@map("events")
}

/// Proyección: estado vigente de cada entidad de la sucursal, derivado de
/// `events`. Es lo que usa el servidor para arbitrar (LWW por versión,
/// transiciones de turno y pedido, rol del actor). Reconstruible con
/// `rebuildProjections`.
model AggregateState {
  branchId      String   @map("branch_id") @db.Uuid
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  /// `version` de la fila (0 si la entidad no versiona).
  version       Int      @default(0)
  /// Turno: open/closed. Pedido: pending/fulfilled/cancelled. Usuario: rol.
  status        String?
  /// Fila vigente tal como la tiene la app (se devuelve en los rechazos).
  row           Json     @db.JsonB
  lastServerSeq BigInt   @map("last_server_seq")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, aggregateType, aggregateId])
  @@index([branchId, aggregateType, status])
  @@map("aggregate_state")
}

/// Turno perdedor de una apertura simultánea → turno ganador. Las ventas y
/// movimientos que llegan con el perdedor se reescriben al ganador.
model ShiftAlias {
  branchId    String   @map("branch_id") @db.Uuid
  fromShiftId String   @map("from_shift_id")
  intoShiftId String   @map("into_shift_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, fromShiftId])
  @@map("shift_aliases")
}

/// Conflictos aceptados pero dignos de revisión (doble cobro, cierre de turno
/// descartado al fusionar).
model SyncConflict {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  kind      String
  eventId   String   @map("event_id") @db.Uuid
  details   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
  @@map("sync_conflicts")
}

// --- Proyecciones de reportes y snapshot -----------------------------------
//
// Cada fila guarda el estado exacto que manda la app en `row` (camelCase,
// fechas ISO-UTC) y columnas extraídas para reportes. Son reconstruibles desde
// `events` con `rebuildProjections`. `aggregate_state` sigue siendo el estado
// de arbitraje; estas tablas no participan en las reglas.

model BranchCategory {
  branchId      String   @map("branch_id") @db.Uuid
  id            String
  name          String?
  sortOrder     Int?     @map("sort_order")
  isActive      Boolean? @map("is_active")
  version       Int      @default(0)
  row           Json     @db.JsonB
  lastServerSeq BigInt   @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, sortOrder])
  @@map("branch_categories")
}

model BranchProduct {
  branchId       String   @map("branch_id") @db.Uuid
  id             String
  categoryId     String?  @map("category_id")
  name           String?
  basePriceCents Int?     @map("base_price_cents")
  sortOrder      Int?     @map("sort_order")
  isActive       Boolean? @map("is_active")
  imagePath      String?  @map("image_path")
  badge          String?
  isSoldOut      Boolean? @map("is_sold_out")
  version        Int      @default(0)
  row            Json     @db.JsonB
  lastServerSeq  BigInt   @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, categoryId, sortOrder])
  @@map("branch_products")
}

model BranchModifierGroup {
  branchId      String  @map("branch_id") @db.Uuid
  id            String
  name          String?
  minSelect     Int?    @map("min_select")
  maxSelect     Int?    @map("max_select")
  sortOrder     Int?    @map("sort_order")
  version       Int     @default(0)
  row           Json    @db.JsonB
  lastServerSeq BigInt  @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, sortOrder])
  @@map("branch_modifier_groups")
}

model BranchModifierOption {
  branchId        String   @map("branch_id") @db.Uuid
  id              String
  modifierGroupId String?  @map("modifier_group_id")
  name            String?
  priceDeltaCents Int?     @map("price_delta_cents")
  sortOrder       Int?     @map("sort_order")
  isActive        Boolean? @map("is_active")
  version         Int      @default(0)
  row             Json     @db.JsonB
  lastServerSeq   BigInt   @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, modifierGroupId, sortOrder])
  @@map("branch_modifier_options")
}

model BranchProductModifierGroup {
  branchId        String @map("branch_id") @db.Uuid
  productId       String @map("product_id")
  modifierGroupId String @map("modifier_group_id")
  sortOrder       Int?   @map("sort_order")
  row             Json   @db.JsonB
  lastServerSeq   BigInt @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, productId, modifierGroupId])
  @@index([branchId, modifierGroupId])
  @@map("branch_product_modifier_groups")
}

model BranchSupply {
  branchId         String   @map("branch_id") @db.Uuid
  id               String
  name             String?
  category         String?
  unit             String?
  supplierName     String?  @map("supplier_name")
  leadTimeHours    Int?     @map("lead_time_hours")
  minQuantityMilli Int?     @map("min_quantity_milli")
  unitCostCents    Int?     @map("unit_cost_cents")
  sortOrder        Int?     @map("sort_order")
  isActive         Boolean? @map("is_active")
  version          Int      @default(0)
  row              Json     @db.JsonB
  lastServerSeq    BigInt   @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, category, sortOrder])
  @@map("branch_supplies")
}

model BranchUser {
  branchId      String   @map("branch_id") @db.Uuid
  id            String
  displayName   String?  @map("display_name")
  role          String?
  isActive      Boolean? @map("is_active")
  version       Int      @default(0)
  row           Json     @db.JsonB
  lastServerSeq BigInt   @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, role, isActive])
  @@map("branch_users")
}

model BranchShift {
  branchId                 String    @map("branch_id") @db.Uuid
  id                       String
  deviceId                 String?   @map("device_id")
  openedAtUtc              DateTime? @map("opened_at_utc") @db.Timestamptz(3)
  openedBusinessDate       String?   @map("opened_business_date")
  startingCashCents        Int?      @map("starting_cash_cents")
  closedAtUtc              DateTime? @map("closed_at_utc") @db.Timestamptz(3)
  closedBusinessDate       String?   @map("closed_business_date")
  closingCountedCashCents  Int?      @map("closing_counted_cash_cents")
  closingExpectedCashCents Int?      @map("closing_expected_cash_cents")
  status                   String?
  openedByUserId           String?   @map("opened_by_user_id")
  closedByUserId           String?   @map("closed_by_user_id")
  version                  Int       @default(0)
  row                      Json      @db.JsonB
  lastServerSeq            BigInt    @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, status])
  @@index([branchId, openedBusinessDate])
  @@map("branch_shifts")
}

model BranchSale {
  branchId      String    @map("branch_id") @db.Uuid
  id            String
  shiftId       String?   @map("shift_id")
  deviceId      String?   @map("device_id")
  businessDate  String?   @map("business_date")
  subtotalCents Int?      @map("subtotal_cents")
  discountCents Int?      @map("discount_cents")
  taxCents      Int?      @map("tax_cents")
  totalCents    Int?      @map("total_cents")
  currencyCode  String?   @map("currency_code")
  channel       String?
  userId        String?   @map("user_id")
  createdAtUtc  DateTime? @map("created_at_utc") @db.Timestamptz(3)
  row           Json      @db.JsonB
  lastServerSeq BigInt    @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, businessDate])
  @@index([branchId, shiftId])
  @@index([branchId, createdAtUtc])
  @@map("branch_sales")
}

model BranchSaleItem {
  branchId               String    @map("branch_id") @db.Uuid
  id                     String
  saleId                 String    @map("sale_id")
  productId              String?   @map("product_id")
  productNameSnapshot    String?   @map("product_name_snapshot")
  unitPriceCentsSnapshot Int?      @map("unit_price_cents_snapshot")
  quantity               Int?
  lineTotalCents         Int?      @map("line_total_cents")
  createdAtUtc           DateTime? @map("created_at_utc") @db.Timestamptz(3)
  row                    Json      @db.JsonB
  lastServerSeq          BigInt    @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, saleId])
  @@index([branchId, productId])
  @@map("branch_sale_items")
}

model BranchSaleItemModifier {
  branchId                   String    @map("branch_id") @db.Uuid
  id                         String
  saleItemId                 String    @map("sale_item_id")
  modifierOptionId           String?   @map("modifier_option_id")
  modifierGroupNameSnapshot  String?   @map("modifier_group_name_snapshot")
  modifierOptionNameSnapshot String?   @map("modifier_option_name_snapshot")
  priceDeltaCentsSnapshot    Int?      @map("price_delta_cents_snapshot")
  createdAtUtc               DateTime? @map("created_at_utc") @db.Timestamptz(3)
  row                        Json      @db.JsonB
  lastServerSeq              BigInt    @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, saleItemId])
  @@map("branch_sale_item_modifiers")
}

model BranchPayment {
  branchId      String    @map("branch_id") @db.Uuid
  id            String
  saleId        String    @map("sale_id")
  method        String?
  amountCents   Int?      @map("amount_cents")
  tenderedCents Int?      @map("tendered_cents")
  changeCents   Int?      @map("change_cents")
  createdAtUtc  DateTime? @map("created_at_utc") @db.Timestamptz(3)
  row           Json      @db.JsonB
  lastServerSeq BigInt    @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, saleId])
  @@index([branchId, method])
  @@map("branch_payments")
}

model BranchCashMovement {
  branchId      String    @map("branch_id") @db.Uuid
  id            String
  shiftId       String?   @map("shift_id")
  deviceId      String?   @map("device_id")
  businessDate  String?   @map("business_date")
  kind          String?
  category      String?
  concept       String?
  amountCents   Int?      @map("amount_cents")
  counterparty  String?
  userId        String?   @map("user_id")
  createdAtUtc  DateTime? @map("created_at_utc") @db.Timestamptz(3)
  row           Json      @db.JsonB
  lastServerSeq BigInt    @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, businessDate])
  @@index([branchId, shiftId])
  @@map("branch_cash_movements")
}

model BranchSupplyMovement {
  branchId           String    @map("branch_id") @db.Uuid
  id                 String
  supplyId           String    @map("supply_id")
  kind               String?
  quantityDeltaMilli Int?      @map("quantity_delta_milli")
  unitCostCents      Int?      @map("unit_cost_cents")
  note               String?
  userId             String?   @map("user_id")
  shiftId            String?   @map("shift_id")
  deviceId           String?   @map("device_id")
  businessDate       String?   @map("business_date")
  createdAtUtc       DateTime? @map("created_at_utc") @db.Timestamptz(3)
  row                Json      @db.JsonB
  lastServerSeq      BigInt    @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, supplyId])
  @@index([branchId, businessDate])
  @@map("branch_supply_movements")
}

model BranchIncomingOrder {
  branchId        String    @map("branch_id") @db.Uuid
  id              String
  channel         String?
  customerName    String?   @map("customer_name")
  pickupAtUtc     DateTime? @map("pickup_at_utc") @db.Timestamptz(3)
  status          String?
  saleId          String?   @map("sale_id")
  deviceId        String?   @map("device_id")
  shiftId         String?   @map("shift_id")
  createdByUserId String?   @map("created_by_user_id")
  createdAtUtc    DateTime? @map("created_at_utc") @db.Timestamptz(3)
  updatedAtUtc    DateTime? @map("updated_at_utc") @db.Timestamptz(3)
  version         Int       @default(0)
  row             Json      @db.JsonB
  lastServerSeq   BigInt    @map("last_server_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, id])
  @@index([branchId, status])
  @@index([branchId, createdAtUtc])
  @@map("branch_incoming_orders")
}
