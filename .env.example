# Postgres (Homebrew local en dev; boba_test para los tests, ver .env.test)
DATABASE_URL="postgresql://USER@localhost:5432/boba_dev?schema=public"
# Llave de los endpoints /v1/admin/* y del CLI. Larga y aleatoria en prod.
ADMIN_API_KEY="change-me"
PORT=4000
# Registro de negocios desde la app (POST /v1/signup). "false" lo cierra.
SIGNUP_ENABLED=true
# "true" exige quién hizo cada cambio de usuarios/catálogo/insumos
# (encenderlo cuando todos los equipos tengan la app actualizada).
REQUIRE_EVENT_ACTOR=false
# Panel del operador (boba_admin): origen(es) permitidos, separados por coma.
ADMIN_PANEL_ORIGIN=http://localhost:5173
# Precio mensual por plan en centavos (MRR estimado del panel).
PLAN_PRICE_PRO_CENTS=14900
PLAN_PRICE_MAX_CENTS=34900
# Detrás de nginx: de quién se cree X-Forwarded-For (IP real para los frenos).
TRUST_PROXY=loopback
# Avisos en tiempo real: postgres (varias instancias) o memory.
REALTIME_BACKEND=postgres
